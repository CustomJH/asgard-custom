# asgard-project-memory — cp .env.example .env 후 채우기. .env 는 커밋 금지 (.gitignore).
# 기본 구성 = MCP 도구 활성 + 관찰(observation)·Reflect 활성. README 참고.
#
# 기본 채택 = 내부망 OpenAI 호환 게이트웨이(LiteLLM). 아래 §LLM 이 그 구성이고,
# 폴백 사다리는  게이트웨이 → 호스트 ollama → none(chunk 모드)  순이다.

# ── 필수 ──────────────────────────────────────────────────────────────────────
# PostgreSQL 비밀번호 (컨테이너 내부 전용 — 그래도 강한 값으로, URL-safe 문자만)
HINDSIGHT_DB_PASSWORD=

# ── LLM — 내부망 LiteLLM 게이트웨이 (기본 채택 구성) ───────────────────────────
# retain(사실 추출)·관찰 통합·Reflect 가 이 연결로 동작한다. recall 은 LLM 을 안 쓴다.
# 게이트웨이 뒤의 실모델은 Qwen3.5-35B-A3B (max-model-len 16384) 이고,
# 게이트웨이가 thinking 을 이미 꺼 둔다 — 그래서 EXTRA_BODY 는 비운다.
HINDSIGHT_LLM_PROVIDER=openai
HINDSIGHT_LLM_MODEL=wams-summary
HINDSIGHT_LLM_BASE_URL=http://172.16.10.174:4001/v1
HINDSIGHT_LLM_API_KEY=sk-wams-local

# 게이트웨이 max_parallel_requests=7 을 제품 트래픽과 나눠 쓴다. 3 = 절반 아래.
# (로컬 ollama 로 폴백할 때는 반드시 1 로 되돌릴 것 — 모델 프로세스가 하나다.)
HINDSIGHT_LLM_MAX_CONCURRENT=3
# Hindsight의 consolidation 예약 2개를 유지하면서 일반 LLM 작업은 하나씩 처리한다.
HINDSIGHT_WORKER_MAX_SLOTS=3

# ── 폴백 1: 호스트 ollama ─────────────────────────────────────────────────────
#HINDSIGHT_LLM_PROVIDER=ollama
#HINDSIGHT_LLM_MODEL=qwen3:8b
#HINDSIGHT_LLM_BASE_URL=http://host.docker.internal:11434/v1
#HINDSIGHT_LLM_EXTRA_BODY={"reasoning_effort":"none"}
#HINDSIGHT_LLM_MAX_CONCURRENT=1

# ── 폴백 2: API 형 provider (anthropic | openai | gemini | groq ...) ──────────
#HINDSIGHT_LLM_PROVIDER=anthropic
#HINDSIGHT_LLM_MODEL=claude-haiku-4-5
#HINDSIGHT_LLM_API_KEY=

# ── 컨텍스트 상한 3종 (모델 max-model-len 에 맞춘다) ──────────────────────────
# 아래 세 값은 compose 기본값이 이미 16384 모델 기준이다. 게이트웨이 모델을
# 더 긴 컨텍스트로 바꾸면 **셋 다 같이** 올려야 한다 — 하나만 올리면 나머지가 병목이 된다.
#HINDSIGHT_RETAIN_MAX_COMPLETION_TOKENS=8192
#HINDSIGHT_CONSOLIDATION_MAX_COMPLETION_TOKENS=4096
#HINDSIGHT_REFLECT_MAX_CONTEXT_TOKENS=10000

# ── 선택 (기본값 있음) ─────────────────────────────────────────────────────────
# 관찰·Reflect 산출 언어 — **비워 두는 것이 기본 결정**이다. 값을 넣으면 "모든 원문을
# 이 언어로 번역하라"가 프롬프트에 붙어, 반대 언어 문서가 통째로 번역돼 저장된다.
# (26-07-28 실측: Korean 고정 → 영어 규격서가 한국어로, English 고정 → "박베타 → Park Beta")
#HINDSIGHT_LLM_OUTPUT_LANGUAGE=

# mission 조향 — 기본 빈칸 확정(2026-07-23): Asgard 어댑터가 증류된 record 를 쓰므로
# 서버측 추출 조향은 왜곡 위험만 키운다. bank 별 observations/reflect mission 도 빈칸 유지.
#HINDSIGHT_RETAIN_MISSION=

# ── 리랭커 — 한국어 회수 품질을 혼자 결정하는 자리 ────────────────────────────
# 26-07-29 실측(같은 뱅크·같은 질의 20개, 리랭커만 교체):
#   ms-marco-MiniLM-L-6-v2 (영어 전용, 업스트림 기본) 한국어 hit@1 0.000 ·  1.97s
#   bge-reranker-base      (278M 다국어, CPU)         한국어 hit@1 0.500 ·  8.18s
#   bge-reranker-v2-m3     (568M 다국어, CPU)         한국어 hit@1 0.857 · 57.05s
#   bge-reranker-v2-m3     (같은 모델, GPU)           한국어 hit@1 0.857 ·  0.535s  ← 권장
#
# GPU 경로는 품질을 하나도 안 내주고 107배 빠르다. 게이트웨이 뒤의 vllm-rerank 가
# 같은 모델을 `--runner pooling`(GPU util 0.06 ≈ 2.8GB)으로 서빙하고 litellm 에
# `wams-rerank` 로 라우팅돼 있다. API_BASE 는 **끝에 /v1** 이어야 한다 (코드가 /rerank 를 덧붙인다).
HINDSIGHT_RERANKER_PROVIDER=litellm
HINDSIGHT_RERANKER_LITELLM_API_BASE=http://172.16.10.174:4001/v1
HINDSIGHT_RERANKER_LITELLM_API_KEY=sk-wams-local
HINDSIGHT_RERANKER_LITELLM_MODEL=wams-rerank

# GPU 를 못 쓰는 배포는 provider 를 local 로 되돌린다. 이때 모델은 반드시 다국어로 —
# 기본값(영어 전용)으로 내려가는 것은 폴백이 아니라 고장이다.
#HINDSIGHT_RERANKER_PROVIDER=local
#HINDSIGHT_RERANKER_LOCAL_MODEL=BAAI/bge-reranker-v2-m3
# 지연이 감당 안 되면 여기까지 — 한국어 정확도를 절반 내주는 거래임을 알고 쓸 것
#HINDSIGHT_RERANKER_LOCAL_MODEL=BAAI/bge-reranker-base

# 리랭크 후보 수 — CPU 경로에서만 의미 있는 손잡이고, 잘 듣지 않는다:
# 80→20 으로 줄이면 지연은 절반밖에 안 주는데(57s→24s) 한국어 hit@1 은 0.857→0.643.
# 비용을 지배하는 것은 후보 개수가 아니라 후보 길이다.
#HINDSIGHT_RERANKER_MAX_CANDIDATES=80

# 이미지 태그 — 운영 안정화 후 특정 버전으로 핀 권장 (현재 실서버 실측 = 0.8.4)
#HINDSIGHT_TAG=0.8.4

# 호스트 포트 (macOS: 8888 이 OrbStack 등과 충돌하면 변경)
#HINDSIGHT_PORT=8888
#HINDSIGHT_UI_PORT=9999

# 컨테이너 메모리 상한 — 호스트를 지키는 장치다 (README §운영 참고)
#HINDSIGHT_MEM_LIMIT=8g

# MCP 표면 (기본 켜짐, 무인증) — 내부망 밖 노출 시 false
#HINDSIGHT_MCP_ENABLED=true
# MCP 클라이언트에 얹을 배포별 사용 지침 (기본 빈칸)
#HINDSIGHT_MCP_INSTRUCTIONS=

# 진단 표면 — LLM 연결 점검 엔드포인트(기본 켬)와 LLM 요청 트레이스 보존일
#HINDSIGHT_ENABLE_BANK_LLM_HEALTH=true
#HINDSIGHT_LLM_TRACE_RETENTION_DAYS=3

# 복수 인스턴스를 한 호스트에 띄울 때만 — worker 신원이 겹치면 서로의 작업을 회수한다
#HINDSIGHT_WORKER_ID=asgard-project-memory-hindsight
