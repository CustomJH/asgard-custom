!.asgard/
.asgard/*
!.asgard/map/
!.asgard/map/**
!.asgard/memory/
.asgard/memory/*
!.asgard/memory/records/
!.asgard/memory/records/**
!.asgard/memory/documents/
!.asgard/memory/documents/**
!.asgard/memory/binding.json
!.asgard/.gitignore
!.asgard/asgard-setting-project.json
!.asgard/MANUAL.md
!.asgard/CUSTOM_MANUAL.md
!.asgard/CUSTOM.md
!.asgard/RULES.md
!.asgard/manual/
!.asgard/manual/**
.claude/settings.local.json
.claude/**/*.local.*
