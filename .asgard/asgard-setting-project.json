{
  "lagom": {
    "mode": "full"
  },
  "project_memory": {
    "engine": "hindsight",
    "endpoint": "http://localhost:18890",
    "project_id": "asgard-custom",
    "timeout": 30
  },
  "agent_models": {},
  "trinity_policy": {
    "schema": 1,
    "roles": {
      "thinker": {
        "tier": "high",
        "effort": "high"
      },
      "worker": {
        "tier": "standard",
        "effort": "medium"
      },
      "verifier": {
        "tier": "high",
        "effort": "high"
      }
    },
    "delivery": {
      "freyja": "standard",
      "thor": "standard",
      "eitri": "standard",
      "loki": "fast",
      "mimir": "standard"
    },
    "budget_priors": {
      "trivial": {
        "turns": 1
      },
      "standard": {
        "turns": 6
      },
      "deep": {
        "turns": 12
      }
    },
    "small_write": {
      "max_files": 2,
      "max_lines": 80
    },
    "sensitive_paths": [
      "hooks",
      "policy",
      "policies",
      "templates",
      "install",
      "security",
      "auth",
      "authn",
      "authz",
      "authentication",
      "authorization",
      "secret",
      "secrets",
      "credentials",
      "db",
      "migration",
      "migrations",
      "ci",
      ".github",
      ".claude",
      ".cursor",
      ".codex"
    ],
    "readonly_commands": [
      "git status",
      "git diff",
      "git log",
      "git show",
      "git ls-files",
      "git rev-parse",
      "rg",
      "grep",
      "ls",
      "cat",
      "head",
      "tail",
      "find",
      "wc",
      "pwd",
      "which"
    ],
    "failure_threshold": 3,
    "verify_level": "low",
    "baseline_checks": [
      "uv run python -m pytest -q -x"
    ],
    "baseline_timeout": 600,
    "baseline_parallel": true,
    "gate_first_max_lines": 25,
    "quest_retention": 30,
    "ticket_runtime": {
      "isolation": true,
      "lease_seconds": 300,
      "max_attempts": 3
    }
  },
  "budget": {
    "session_cost_units": 30000000
  },
  "paths": {
    "additional_roots": [
      "../satellite-pilot",
      "~/develop/work_space/vn_onm/helios-asgard",
      "../asgard-custom-test"
    ]
  }
}